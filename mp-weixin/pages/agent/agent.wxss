/* AI 助手聊天页面样式 */

.agent-page {
  height: 100%;
  width: 100%;
  display: flex;
  flex-direction: column;
  background: #f6f6f6;
  overflow: hidden;
}

/* ===== 自定义顶部导航栏 ===== */
.agent-header {
  background: #e95f3c;
  flex-shrink: 0;
}

.status-bar {
  width: 100%;
}

.nav-row {
  height: 88rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.header-back {
  position: absolute;
  left: 0;
  top: 0;
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  width: 36rpx;
  height: 36rpx;
}

.header-title {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 600;
}

/* ===== 主体 ===== */
.agent-body {
  flex: 1;
  display: flex;
  min-height: 0;
}

/* ===== 左侧会话列表 ===== */
.sidebar {
  width: 240rpx;
  min-width: 240rpx;
  background: #2b2f3a;
  display: flex;
  flex-direction: column;
}

.sidebar-top {
  padding: 20rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.new-chat {
  background: #e95f3c;
  color: #ffffff;
  font-size: 26rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 12rpx;
}

.session-scroll {
  flex: 1;
  height: 0;
}

.session-item {
  padding: 24rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
  color: #cfd3dc;
}

.session-item.active {
  background: #3a3f4d;
  color: #ffffff;
}

.session-title {
  font-size: 26rpx;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.session-more {
  font-size: 24rpx;
  color: #8a90a0;
  margin-left: 8rpx;
}

.session-empty {
  color: #8a90a0;
  font-size: 24rpx;
  text-align: center;
  padding: 40rpx 0;
}

/* ===== 右侧聊天区 ===== */
.chat-area {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.chat-header {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #ffffff;
  border-bottom: 1rpx solid #eeeeee;
  font-size: 30rpx;
  color: #333333;
  font-weight: 600;
  padding: 0 20rpx;
}

.chat-title {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.msg-scroll {
  flex: 1;
  height: 0;
  background: #f6f6f6;
}

.msg-list {
  padding: 24rpx 20rpx 40rpx;
}

.msg-row {
  display: flex;
  margin-bottom: 24rpx;
}

.row-user {
  justify-content: flex-end;
}

.row-assistant {
  justify-content: flex-start;
}

.bubble {
  max-width: 82%;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
  white-space: pre-wrap;
}

.bubble-user {
  background: #e95f3c;
  color: #ffffff;
  border-top-right-radius: 4rpx;
}

.bubble-assistant {
  background: #ffffff;
  color: #333333;
  border-top-left-radius: 4rpx;
}

.msg-line {
  min-height: 1em;
}

.seg-bold {
  font-weight: 700;
}

.typing-cursor {
  color: #e95f3c;
  font-size: 28rpx;
  animation: blink 1s infinite;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}

.anchor {
  height: 1rpx;
  width: 1rpx;
}

/* ===== 底部输入区 ===== */
.input-bar {
  display: flex;
  align-items: flex-end;
  padding: 16rpx 20rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #eeeeee;
}

.chat-input {
  flex: 1;
  min-height: 64rpx;
  max-height: 200rpx;
  width: auto;
  background: #f2f2f2;
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

.input-placeholder {
  color: #bbbbbb;
}

.send-btn {
  margin-left: 16rpx;
  width: 120rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  background: #e95f3c;
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 28rpx;
  flex-shrink: 0;
}

.send-disabled {
  background: #f0b3a3;
  color: #ffffff;
}
